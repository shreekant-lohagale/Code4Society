# EcoGuard Frontend Environment Variables (Vite)

# The URL of your Render/Node backend
# Local: http://localhost:5005
# Production: https://your-backend-url.onrender.com
VITE_BACKEND_URL=

# The URL of your Render/Flask Virtual Forest backend
# Local: http://localhost:5001
# Production: https://your-forest-url.onrender.com
VITE_GAMIFICATION_URL=

# Note: All variables must start with VITE_ to be accessible in the React code.
